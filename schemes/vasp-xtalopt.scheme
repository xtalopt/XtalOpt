[xtalopt]
optscheme\numOptSteps=6
optscheme\optimizer\0\assets\vasp\POTCAR=%filecontents:/path/to/first/potcar/alphabetical/order%\n%filecontents:/path/to/second/potcar/alphabetical/order%
optscheme\optimizer\0\interface=vasp
optscheme\optimizer\0\templates\vasp\INCAR="%filename%\n\n# output options\nLWAVE  = .FALSE. # write or don't write WAVECAR\nLCHARG = .FALSE. # write or don't write CHG and CHGCAR\nLELF   = .FALSE. # write ELF\n\n# ionic relaxation\nNSW = 20         # number of ionic steps\nIBRION = 2       # 2=conjucate gradient, 1=Newton like\nISIF = 2         # 3=relax everything, 2=relax ions only, 4=keep volume fixed\n\n# precision parameters\nEDIFF = 1E-3     # 1E-3 very low precision for pre-relaxation, use 1E-5 next\nEDIFFG = 1E-2    # usually: 10 * EDIFF\nPREC = med       # precision low, med, high, accurate\n\n# electronic relaxation\nISMEAR = -5      # -5 = tetraedon, 1..N = Methfessel\nENCUT = %user3%      # cutoff energy\nPSTRESS = %user2%\nISYM=0"
optscheme\optimizer\0\templates\vasp\KPOINTS=Automatic generation\n0\nAuto\n20
optscheme\optimizer\1\assets\vasp\POTCAR=%filecontents:/path/to/first/potcar/alphabetical/order%\n%filecontents:/path/to/second/potcar/alphabetical/order%
optscheme\optimizer\1\interface=vasp
optscheme\optimizer\1\templates\vasp\INCAR="%filename%\n\n# output options\nLWAVE  = .FALSE. # write or don't write WAVECAR\nLCHARG = .FALSE. # write or don't write CHG and CHGCAR\nLELF   = .FALSE. # write ELF\n\n# ionic relaxation\nNSW = 20         # number of ionic steps\nIBRION = 2       # 2=conjucate gradient, 1=Newton like\nISIF = 4         # 3=relax everything, 2=relax ions only, 4=keep volume fixed\n\n# precision parameters\nEDIFF = 1E-3     # 1E-3 very low precision for pre-relaxation, use 1E-5 next\nEDIFFG = 1E-2    # usually: 10 * EDIFF\nPREC = med       # precision low, med, high, accurate\n\n# electronic relaxation\nISMEAR = -5      # -5 = tetraedon, 1..N = Methfessel\nENCUT = %user3%      # cutoff energy\nPSTRESS = %user2%\nISYM=0"
optscheme\optimizer\1\templates\vasp\KPOINTS=Automatic generation\n0\nAuto\n25
optscheme\optimizer\2\assets\vasp\POTCAR=%filecontents:/path/to/first/potcar/alphabetical/order%\n%filecontents:/path/to/second/potcar/alphabetical/order%
optscheme\optimizer\2\interface=vasp
optscheme\optimizer\2\templates\vasp\INCAR="%filename%\n        \n# output options\nLWAVE  = .FALSE. # write or don't write WAVECAR\nLCHARG = .FALSE. # write or don't write CHG and CHGCAR\nLELF   = .FALSE. # write ELF\n\n# ionic relaxation\nNSW = 20         # number of ionic steps\nIBRION = 2       # 2=conjucate gradient, 1=Newton like\nISIF = 3         # 3=relax everything, 2=relax ions only, 4=keep volume fixed\n\n# precision parameters\nEDIFF = 1E-3     # 1E-3 very low precision for pre-relaxation, use 1E-5 next\nEDIFFG = 1E-2    # usually: 10 * EDIFF\nPREC = med       # precision low, med, high, accurate\n\n# electronic relaxation\nISMEAR = -5      # -5 = tetraedon, 1..N = Methfessel\nENCUT = %user3%      # cutoff energy\nPSTRESS = %user2%\nISYM=0"
optscheme\optimizer\2\templates\vasp\KPOINTS=Automatic generation\n0\nAuto\n30
optscheme\optimizer\3\assets\vasp\POTCAR=%filecontents:/path/to/first/potcar/alphabetical/order%\n%filecontents:/path/to/second/potcar/alphabetical/order%
optscheme\optimizer\3\interface=vasp
optscheme\optimizer\3\templates\vasp\INCAR="%filename%\n\n# output options\nLWAVE  = .FALSE. # write or don't write WAVECAR\nLCHARG = .FALSE. # write or don't write CHG and CHGCAR\nLELF   = .FALSE. # write ELF\n\n# ionic relaxation\nNSW = 100        # number of ionic steps\nIBRION = 2       # 2=conjucate gradient, 1=Newton like\nISIF = 3         # 3=relax everything, 2=relax ions only, 4=keep volume fixed\n\n# precision parameters\nEDIFF = 1E-5     # 1E-3 very low precision for pre-relaxation, use 1E-5 next\nEDIFFG = 1E-4    # usually: 10 * EDIFF\nPREC = med       # precision low, med, high, accurate\n\n# electronic relaxation\nISMEAR = -5      # -5 = tetraedon, 1..N = Methfessel\nENCUT = %user3%      # cutoff energy\nPSTRESS = %user2%\n#ISYM=0"
optscheme\optimizer\3\templates\vasp\KPOINTS=Automatic generation\n0\nAuto\n30
optscheme\optimizer\4\assets\vasp\POTCAR=%filecontents:/path/to/first/potcar/alphabetical/order%\n%filecontents:/path/to/second/potcar/alphabetical/order%
optscheme\optimizer\4\interface=vasp
optscheme\optimizer\4\templates\vasp\INCAR="%filename%\n\n# output options\nLWAVE  = .FALSE. # write or don't write WAVECAR\nLCHARG = .FALSE. # write or don't write CHG and CHGCAR\nLELF   = .FALSE. # write ELF\n\n# ionic relaxation\nNSW = 100        # number of ionic steps\nIBRION = 2       # 2=conjucate gradient, 1=Newton like\nISIF = 3         # 3=relax everything, 2=relax ions only, 4=keep volume fixed\n\n# precision parameters\nEDIFF = 1E-5     # 1E-3 very low precision for pre-relaxation, use 1E-5 next\nEDIFFG = 1E-4    # usually: 10 * EDIFF\nPREC = high      # precision low, med, high, accurate\n\n# electronic relaxation\nISMEAR = -5      # -5 = tetraedon, 1..N = Methfessel\nENCUT = %user3%      # cutoff energy\nPSTRESS = %user2%\n#ISYM=0"
optscheme\optimizer\4\templates\vasp\KPOINTS=Automatic generation\n0\nAuto\n40
optscheme\optimizer\5\assets\vasp\POTCAR=%filecontents:/path/to/first/potcar/alphabetical/order%\n%filecontents:/path/to/second/potcar/alphabetical/order%
optscheme\optimizer\5\interface=vasp
optscheme\optimizer\5\templates\vasp\INCAR="%filename%\n\n# output options\nLWAVE  = .FALSE. # write or don't write WAVECAR\nLCHARG = .FALSE. # write or don't write CHG and CHGCAR\nLELF   = .FALSE. # write ELF\n\n# ionic relaxation\nNSW = 100        # number of ionic steps\nIBRION = 2       # 2=conjucate gradient, 1=Newton like\nISIF = 3         # 3=relax everything, 2=relax ions only, 4=keep volume fixed\n\n# precision parameters\nEDIFF = 1E-5     # 1E-3 very low precision for pre-relaxation, use 1E-5 next\nEDIFFG = 1E-4    # usually: 10 * EDIFF\nPREC = high      # precision low, med, high, accurate\n\n# electronic relaxation\nISMEAR = -5      # -5 = tetraedon, 1..N = Methfessel\nENCUT = %user3%      # cutoff energy\nPSTRESS = %user2%\n#ISYM=0"
optscheme\optimizer\5\templates\vasp\KPOINTS=Automatic generation\n0\nAuto\n50
optscheme\queue\0\commands\pbs\cancel=qdel
optscheme\queue\0\commands\pbs\status=qstat
optscheme\queue\0\commands\pbs\submit=qsub
optscheme\queue\0\interface=pbs
optscheme\queue\0\templates\pbs\job.pbs="#/bin/bash                                                                    \n#PBS -q parity                                                                 \n#PBS -l nodes=1:ppn=8                                                         \n#PBS -o ../%gen%x%id%-%incar%.out                                   \n#PBS -N %description%-%gen%x%id%-%optStep%\n#PBS -j oe\n#PBS -m e\n##PBS -W umask=022\n\n###Include this for xtalopt scripts!###\nexport PBS_O_WORKDIR=%rempath%\necho $PBS_O_WORKDIR\n# -----------------------------------------------------------------------\n# start: prepare script to clean up scratch directories\n# -----------------------------------------------------------------------\nCLEANUPSCRIPT=~/pbscleanup_$PBS_JOBID.sh\necho \"# clean up job $PBS_JOBID\" >$CLEANUPSCRIPT\nfor i in `cat $PBS_NODEFILE | sort | uniq`; do\necho \"ssh $i \\\"rm -r $PBSTMPDIR\\\" \" >> $CLEANUPSCRIPT\ndone\nchmod +x $CLEANUPSCRIPT\n# -----------------------------------------------------------------------\n# end:  prepare script to clean up scratch directories\n# -----------------------------------------------------------------------\n\nsource /etc/profile.d/modules.sh\nmodule load vasp/4.6-impi-3.2-ib\nexport I_MPI_PIN=0\n\ncd $PBS_O_WORKDIR\nfor node in `cat $PBS_NODEFILE | sort | uniq`; do\nssh $node \"cp $PBS_O_WORKDIR/* $PBSTMPDIR/;\";                                                                                                                                      \ndone                                                                                                                                                                               \ncd $PBSTMPDIR                                                                                                                                                                      \necho \"running in directory $PBSTMPDIR\"                                                                                                                                             \n                                                                                                                                                                                   \n###########                                                                                                                                                                        \n# End PBS setup. User comands start below.                                                                                                                                         \n# Do NOT redirect standard output. It will all be collected in                                                                                                                     \n# the PBS output file specified in the header above.                                                                                                                               \n###########                                                                                                                                                                        \n                                                                                                                                                                                   \nNPROCS=`cat $PBS_NODEFILE | wc -l`                                                                                                                                                 \nNNODES=`cat $PBS_NODEFILE | uniq | wc -l`                                                                                                                                          \nUNIQ_HOSTS=tmp.hosts                                                                                                                                                               \ncat $PBS_NODEFILE | uniq > $UNIQ_HOSTS                                                                                                                                             \nHOSTS_uniq=`cat $PBS_NODEFILE | uniq`                                                                                                                                              \n                                                                                                                                                                                   \nmpdboot -n $NNODES -f $UNIQ_HOSTS -r /usr/bin/ssh -v                                                                                                                               \necho \"Running on $NPROCS processors across $NNODES nodes.\"                                                                                                                         \nmpiexec -machinefile $PBS_NODEFILE -np $NPROCS -envuser vasp                                                                                                                       \n                                                                                                                                                                                   \nmpdtrace                                                                                                                                                                           \nmpdallexit                                                                                                                                                                         \n              \nfor node in `cat $PBS_NODEFILE | sort | uniq`; do                                                                                                                                  \nssh $node \"ls -l $PBSTMPDIR\"                                                                                                                                                       \ndone                                                                                                                                                                               \ncp $PBSTMPDIR/* $PBS_O_WORKDIR/"
optscheme\queue\1\commands\pbs\cancel=qdel
optscheme\queue\1\commands\pbs\status=qstat
optscheme\queue\1\commands\pbs\submit=qsub
optscheme\queue\1\interface=pbs
optscheme\queue\1\templates\pbs\job.pbs="#/bin/bash                                                                    \n#PBS -q parity                                                                 \n#PBS -l nodes=1:ppn=8                                                         \n#PBS -o ../%gen%x%id%-%incar%.out                                   \n#PBS -N %description%-%gen%x%id%-%optStep%\n#PBS -j oe\n#PBS -m e\n##PBS -W umask=022\n\n###Include this for xtalopt scripts!###\nexport PBS_O_WORKDIR=%rempath%\necho $PBS_O_WORKDIR\n# -----------------------------------------------------------------------\n# start: prepare script to clean up scratch directories\n# -----------------------------------------------------------------------\nCLEANUPSCRIPT=~/pbscleanup_$PBS_JOBID.sh\necho \"# clean up job $PBS_JOBID\" >$CLEANUPSCRIPT\nfor i in `cat $PBS_NODEFILE | sort | uniq`; do\necho \"ssh $i \\\"rm -r $PBSTMPDIR\\\" \" >> $CLEANUPSCRIPT\ndone\nchmod +x $CLEANUPSCRIPT\n# -----------------------------------------------------------------------\n# end:  prepare script to clean up scratch directories\n# -----------------------------------------------------------------------\n\nsource /etc/profile.d/modules.sh\nmodule load vasp/4.6-impi-3.2-ib\nexport I_MPI_PIN=0\n\ncd $PBS_O_WORKDIR\nfor node in `cat $PBS_NODEFILE | sort | uniq`; do\nssh $node \"cp $PBS_O_WORKDIR/* $PBSTMPDIR/;\";                                                                                                                                      \ndone                                                                                                                                                                               \ncd $PBSTMPDIR                                                                                                                                                                      \necho \"running in directory $PBSTMPDIR\"                                                                                                                                             \n                                                                                                                                                                                   \n###########                                                                                                                                                                        \n# End PBS setup. User comands start below.                                                                                                                                         \n# Do NOT redirect standard output. It will all be collected in                                                                                                                     \n# the PBS output file specified in the header above.                                                                                                                               \n###########                                                                                                                                                                        \n                                                                                                                                                                                   \nNPROCS=`cat $PBS_NODEFILE | wc -l`                                                                                                                                                 \nNNODES=`cat $PBS_NODEFILE | uniq | wc -l`                                                                                                                                          \nUNIQ_HOSTS=tmp.hosts                                                                                                                                                               \ncat $PBS_NODEFILE | uniq > $UNIQ_HOSTS                                                                                                                                             \nHOSTS_uniq=`cat $PBS_NODEFILE | uniq`                                                                                                                                              \n                                                                                                                                                                                   \nmpdboot -n $NNODES -f $UNIQ_HOSTS -r /usr/bin/ssh -v                                                                                                                               \necho \"Running on $NPROCS processors across $NNODES nodes.\"                                                                                                                         \nmpiexec -machinefile $PBS_NODEFILE -np $NPROCS -envuser vasp                                                                                                                       \n                                                                                                                                                                                   \nmpdtrace                                                                                                                                                                           \nmpdallexit                                                                                                                                                                         \n              \nfor node in `cat $PBS_NODEFILE | sort | uniq`; do                                                                                                                                  \nssh $node \"ls -l $PBSTMPDIR\"                                                                                                                                                       \ndone                                                                                                                                                                               \ncp $PBSTMPDIR/* $PBS_O_WORKDIR/"

DI_ICON1 ICON DISCARDABLE "@XTALOPT_RC_ICON_PATH@"

1 VERSIONINFO
FILEVERSION @XTALOPT_RC_FILEVERSION@
PRODUCTVERSION @XTALOPT_RC_FILEVERSION@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "XtalOpt"
      VALUE "FileDescription", "XtalOpt evolutionary crystal structure prediction"
      VALUE "FileVersion", "@XtalOpt_VERSION_FULL@"
      VALUE "ProductVersion", "@XtalOpt_VERSION_FULL@"
      VALUE "LegalCopyright", "Released under the New BSD License"
      VALUE "OriginalFilename", "xtalopt.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

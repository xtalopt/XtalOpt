        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Optimization weight for the objective.&lt;/p&gt;&lt;p&gt;(1) This should be a float number, larger than or equal to 0.0, and less than or equal to 1.0.&lt;/p&gt;&lt;p&gt;(2) Total weight for all objectives should be less than or equal to 1.0.&lt;/p&gt;&lt;p&gt;(3) If this is set to zero, that objective is calculated but not included in optimization.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>

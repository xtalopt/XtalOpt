        </font>
       </property>
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Automatically cancel a running optimization job after the set time; the next pending job is then submitted.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
